confirm_exploit: true
exploitation: true
global_model: null
agent_turns: 60
sliding_turns: true
turn_ceiling_factor: 5
agent_models: {}
temperature_default: 0.4
agent_temperatures:
  pentest/report: 0.2
active_provider: anthropic
# Base URL for the `local` provider (Ollama, LM Studio, llama.cpp, vLLM — anything
# OpenAI-compatible). Set it with `/provider set local <url>` or here directly.
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
local_base_url: null
cycles_per_surface: 4
dry_cycles_per_surface: 2
total_cycles: 40
surfaces: 50
parallel: false
parallel_agents: 3
surface_fanout: 3
hypothesis_fanout: 3
hypothesis_turns: 12
frontier_actions: null
frontier_attempts: 3
validation: false
llm_routing: true
router_model: null
repeat_nudge: 3
nudge_exempt_tools:
- oob_listener
- check_jobs
- list_shells
- wait
pivot_nudge: 4
reuse_nudge: 10
grind_nudge: 12
kill_exempt_tools:
- apt_install
- pip_install
package_install: true
web_search: false

# Debug: capture full LLM request/response/command transcripts to llm_debug.log in
# the engagement results dir. Unredacted (real secrets in plaintext) — leave off
# unless debugging. Toggle live with /config debug on|off.
debug: false

hashcat_wordlist: /usr/share/wordlists/rockyou.txt
hashcat_rules: /usr/share/hashcat/rules/OneRuleToRuleThemAll.rule
hashcat_binary: hashcat
