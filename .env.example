# API keys. A key set here (this file is auto-loaded at startup) or exported in the
# shell is checked BEFORE the OS keyring — so setting one avoids the keyring's unlock
# prompt on a headless / SSH session (including at report time). The keyring, via
# `/key set <key>` inside the app, is the fallback. Set only the provider(s) you use;
# switch with `/provider set`.
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
NVIDIA_API_KEY=nvapi-...
